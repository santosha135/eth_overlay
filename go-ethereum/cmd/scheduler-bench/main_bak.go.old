package main

import (
	"encoding/csv"
	"fmt"
	"os"
	"runtime"
	"strconv"
	"time"

	"github.com/ethereum/go-ethereum/src/bucket"
)

const (
	totalMiners    = 30
	rotationBlocks = uint64(1)

	// Number of operations inside one timed batch.
	//
	// LeaderIndex is extremely fast (~tens of ns), so timing
	// one operation at a time adds too much timer overhead.
	callsPerBatch = 10000

	// Number of independent batches measured for each miner.
	batches = 1000

	// Warm-up calls before measurements.
	warmupCalls = 100000
)

// Prevent compiler from optimizing benchmark results away.
var leaderSink int
var rotationSink int
var epochSink uint64

func main() {

	bucketCounts := []int{5, 10, 15, 30}

	fmt.Println("============================================================")
	fmt.Println("SCHEDULER MICROBENCHMARK")
	fmt.Println("============================================================")

	fmt.Printf("Total miners       : %d\n", totalMiners)
	fmt.Printf("Calls per batch    : %d\n", callsPerBatch)
	fmt.Printf("Batches per miner  : %d\n", batches)
	fmt.Printf("Warm-up calls      : %d\n", warmupCalls)

	// ============================================================
	// LEADER SELECTION
	// ============================================================

	fmt.Println()
	fmt.Println("============================================================")
	fmt.Println("LEADER SELECTION BENCHMARK")
	fmt.Println("============================================================")

	for _, numBuckets := range bucketCounts {

		// Run GC BEFORE a complete configuration,
		// not inside the timed region.
		runtime.GC()

		runLeaderBenchmark(numBuckets)
	}

	// ============================================================
	// BUCKET ROTATION
	// ============================================================

	fmt.Println()
	fmt.Println("============================================================")
	fmt.Println("BUCKET ROTATION BENCHMARK")
	fmt.Println("============================================================")

	for _, numBuckets := range bucketCounts {

		runtime.GC()

		runRotationBenchmark(numBuckets)
	}

	// Make benchmark outputs observable.
	runtime.KeepAlive(leaderSink)
	runtime.KeepAlive(rotationSink)
	runtime.KeepAlive(epochSink)

	fmt.Println()
	fmt.Println("============================================================")
	fmt.Println("BENCHMARK FINISHED")
	fmt.Println("============================================================")
}

// ================================================================
// LEADER SELECTION BENCHMARK
// ================================================================

func runLeaderBenchmark(numBuckets int) {

	filename := fmt.Sprintf(
		"leader_selection_%d_buckets.csv",
		numBuckets,
	)

	file, err := os.Create(filename)
	if err != nil {
		panic(err)
	}
	defer file.Close()

	writer := csv.NewWriter(file)
	defer writer.Flush()

	// ============================================================
	// CSV HEADER
	// ============================================================

	err = writer.Write([]string{
		"batch",
		"num_buckets",
		"total_miners",
		"miner_index",
		"group_id",
		"member_index",
		"group_size",
		"calls_per_batch",
		"start_epoch",
		"total_duration_ns",
		"duration_ns_per_call",
	})

	if err != nil {
		panic(err)
	}

	fmt.Printf(
		"\n%d buckets: leader benchmark started\n",
		numBuckets,
	)

	// ============================================================
	// EVERY MINER
	// ============================================================

	for minerIndex := 0; minerIndex < totalMiners; minerIndex++ {

		groupID, memberIndex, groupSize :=
			bucket.BuildMinerGroupAssignment(
				minerIndex,
				totalMiners,
				numBuckets,
			)

		// Print group layout once.
		fmt.Printf(
			"  Miner %2d -> group=%2d member=%d groupSize=%d\n",
			minerIndex,
			groupID,
			memberIndex,
			groupSize,
		)

		// ========================================================
		// WARM-UP
		// ========================================================

		for i := 0; i < warmupCalls; i++ {

			leaderSink = bucket.LeaderIndex(
				uint64(i),
				groupID,
				groupSize,
			)
		}

		// ========================================================
		// MEASURE BATCHES
		// ========================================================

		for batch := 0; batch < batches; batch++ {

			startEpoch :=
				uint64(batch * callsPerBatch)

			// ----------------------------------------------------
			// TIMER START
			// ----------------------------------------------------

			start := time.Now()

			for j := 0; j < callsPerBatch; j++ {

				epoch :=
					startEpoch + uint64(j)

				leaderSink =
					bucket.LeaderIndex(
						epoch,
						groupID,
						groupSize,
					)
			}

			elapsed := time.Since(start)

			// ----------------------------------------------------
			// TIMER STOPPED
			// ----------------------------------------------------

			totalDurationNS :=
				elapsed.Nanoseconds()

			nsPerCall :=
				float64(totalDurationNS) /
					float64(callsPerBatch)

			// CSV is outside the timed region.
			err := writer.Write([]string{
				strconv.Itoa(batch),
				strconv.Itoa(numBuckets),
				strconv.Itoa(totalMiners),
				strconv.Itoa(minerIndex),
				strconv.Itoa(groupID),
				strconv.Itoa(memberIndex),
				strconv.Itoa(groupSize),
				strconv.Itoa(callsPerBatch),
				strconv.FormatUint(
					startEpoch,
					10,
				),
				strconv.FormatInt(
					totalDurationNS,
					10,
				),
				strconv.FormatFloat(
					nsPerCall,
					'f',
					6,
					64,
				),
			})

			if err != nil {
				panic(err)
			}
		}
	}

	writer.Flush()

	if err := writer.Error(); err != nil {
		panic(err)
	}

	fmt.Printf(
		"%d buckets: leader selection finished -> %s\n",
		numBuckets,
		filename,
	)
}

// ================================================================
// BUCKET ROTATION BENCHMARK
// ================================================================

func runRotationBenchmark(numBuckets int) {

	filename := fmt.Sprintf(
		"bucket_rotation_%d_buckets.csv",
		numBuckets,
	)

	file, err := os.Create(filename)
	if err != nil {
		panic(err)
	}
	defer file.Close()

	writer := csv.NewWriter(file)
	defer writer.Flush()

	err = writer.Write([]string{
		"batch",
		"num_buckets",
		"total_miners",
		"miner_index",
		"group_id",
		"member_index",
		"group_size",
		"calls_per_batch",
		"start_block",
		"total_duration_ns",
		"duration_ns_per_call",
	})

	if err != nil {
		panic(err)
	}

	fmt.Printf(
		"\n%d buckets: rotation benchmark started\n",
		numBuckets,
	)

	// ============================================================
	// EVERY MINER
	// ============================================================

	for minerIndex := 0; minerIndex < totalMiners; minerIndex++ {

		groupID, memberIndex, groupSize :=
			bucket.BuildMinerGroupAssignment(
				minerIndex,
				totalMiners,
				numBuckets,
			)

		scheduler :=
			bucket.NewScheduler(
				numBuckets,
				groupID,
				rotationBlocks,
			)

		// ========================================================
		// WARM-UP
		// ========================================================

		for i := 1; i <= warmupCalls; i++ {

			blockNumber := uint64(i)

			scheduler.SetHeadBlock(
				blockNumber,
			)

			epochSink =
				scheduler.Epoch()

			rotationSink =
				scheduler.ActiveBucket()
		}

		// ========================================================
		// MEASURE BATCHES
		// ========================================================

		for batch := 0; batch < batches; batch++ {

			startBlock :=
				uint64(batch*callsPerBatch + 1)

			// ----------------------------------------------------
			// TIMER START
			// ----------------------------------------------------

			start := time.Now()

			for j := 0; j < callsPerBatch; j++ {

				blockNumber :=
					startBlock + uint64(j)

				scheduler.SetHeadBlock(
					blockNumber,
				)

				epochSink =
					scheduler.Epoch()

				rotationSink =
					scheduler.ActiveBucket()
			}

			elapsed := time.Since(start)

			// ----------------------------------------------------
			// TIMER STOPPED
			// ----------------------------------------------------

			totalDurationNS :=
				elapsed.Nanoseconds()

			nsPerCall :=
				float64(totalDurationNS) /
					float64(callsPerBatch)

			err := writer.Write([]string{
				strconv.Itoa(batch),
				strconv.Itoa(numBuckets),
				strconv.Itoa(totalMiners),
				strconv.Itoa(minerIndex),
				strconv.Itoa(groupID),
				strconv.Itoa(memberIndex),
				strconv.Itoa(groupSize),
				strconv.Itoa(callsPerBatch),
				strconv.FormatUint(
					startBlock,
					10,
				),
				strconv.FormatInt(
					totalDurationNS,
					10,
				),
				strconv.FormatFloat(
					nsPerCall,
					'f',
					6,
					64,
				),
			})

			if err != nil {
				panic(err)
			}
		}
	}

	writer.Flush()

	if err := writer.Error(); err != nil {
		panic(err)
	}

	fmt.Printf(
		"%d buckets: bucket rotation finished -> %s\n",
		numBuckets,
		filename,
	)
}